{
  "entities": {
    "Order": {
      "title": "Delivery Order",
      "description": "Logistics delivery order with status, pricing, courier tags and GPS coordinates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceType": { "type": "string" },
        "batchId": { "type": "string" },
        "batchName": { "type": "string" },
        "mamilaId": { "type": "string" },
        "mamilaName": { "type": "string" },
        "mamilaLocation": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerCity": { "type": "string" },
        "customerPlusCode": { "type": "string" },
        "customerAddress": { "type": "string" },
        "runnerId": { "type": "string" },
        "runnerName": { "type": "string" },
        "riderId": { "type": "string" },
        "riderName": { "type": "string" },
        "runnerTagId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "serviceType", "price", "status", "customerId"]
    },
    "Batch": {
      "title": "Store Product Batch",
      "description": "Mamila store product batch inventory record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mamilaId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "available": { "type": "number" },
        "expiry": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "mamilaId", "name", "price", "available"]
    },
    "ChatMessage": {
      "title": "Dispatch Communication Message",
      "description": "Vernacular runner-rider-customer coordination message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "sender": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "orderId", "sender", "role", "text"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of express delivery and parcel orders"
    },
    "/batches/{batchId}": {
      "schema": "Batch",
      "description": "Collection of store merchandise and food inventory batches"
    },
    "/orderChats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Dispatcher and courier communication messages"
    }
  }
}
